{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Overshoot",
  "description": "Overshoot is a real-time video understanding API: ingest live frames over WebRTC and query them with vision-language models through an OpenAI-compatible interface.",
  "colors": {
    "primary": "#171717",
    "light": "#FAFAFA",
    "dark": "#171717"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "versions": [
      {
        "version": "v1",
        "default": true,
        "tabs": [
          {
            "tab": "Guides",
            "icon": "book-open",
            "pages": [
              "intro",
              "quickstart",
              "the-stream",
              "chat-completion",
              "models",
              "glossary",
              "best-practices"
            ]
          },
          {
            "tab": "API reference",
            "icon": "code",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/core-flow",
              "api-reference/stream-lifecycle",
              "api-reference/stream-media-urls",
              {
                "group": "Chat",
                "icon": "message",
                "pages": [
                  "api-reference/chat-completions"
                ]
              },
              {
                "group": "Streams",
                "icon": "video",
                "pages": [
                  "api-reference/create-stream",
                  "api-reference/get-stream",
                  "api-reference/keepalive-stream",
                  "api-reference/delete-stream"
                ]
              },
              {
                "group": "Models & pricing",
                "icon": "microchip-ai",
                "pages": [
                  "api-reference/list-models",
                  "api-reference/list-pricing",
                  "api-reference/get-pricing",
                  "api-reference/get-balance",
                  "api-reference/create-checkout"
                ]
              },
              "api-reference/livekit-client-flow",
              "api-reference/regions",
              "api-reference/prompt-cache",
              "api-reference/errors",
              "api-reference/limits"
            ]
          }
        ]
      },
      {
        "version": "v0.2",
        "tabs": [
          {
            "tab": "API reference",
            "icon": "code",
            "pages": [
              "api-reference/v0.2/introduction",
              {
                "group": "Streams",
                "icon": "video",
                "pages": [
                  "api-reference/v0.2/create-stream",
                  "api-reference/v0.2/stream-info",
                  "api-reference/v0.2/keepalive-stream",
                  "api-reference/v0.2/update-prompt",
                  "api-reference/v0.2/spectate-stream",
                  "api-reference/v0.2/close-stream"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:founders@overshoot.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Platform",
      "href": "https://platform.overshoot.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
